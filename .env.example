# .env.example — RevivePay AI Environment Variables
#
# Copy this file to .env and fill in real values where needed.
# .env is git-ignored. NEVER commit a real key to version control.
# The system runs fully end-to-end with no real API keys (LLM_PROVIDER=mock).
#
# Each variable has a placeholder value and a one-line description.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
APP_ENV=development

# Human-readable name used in logs and the UI header
APP_NAME=RevivePay AI

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------

# Host the FastAPI server binds to (0.0.0.0 for Docker, 127.0.0.1 for local)
API_HOST=127.0.0.1

# Port the FastAPI server listens on
API_PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLAlchemy connection URL. Change to postgresql+asyncpg://... for Postgres.
DATABASE_URL=sqlite+aiosqlite:///./revivepay.db

# ---------------------------------------------------------------------------
# API Authentication
# ---------------------------------------------------------------------------

# Bearer token for operator-level access (read + write + admin)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_OPERATOR=change-me-operator-key-placeholder

# Bearer token for viewer-level access (read only)
API_KEY_VIEWER=change-me-viewer-key-placeholder

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------

# Which LLM provider to use: mock | gemini | openai | anthropic
# "mock" requires no API key and is deterministic — use for demos and CI.
LLM_PROVIDER=mock

# Model identifier passed to the selected provider (ignored by mock)
LLM_MODEL=gemini-2.0-flash

# Seconds before an LLM call is considered timed out
LLM_TIMEOUT_SECONDS=30

# Number of times to retry a failed LLM call before raising
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# LLM API Keys (leave as placeholder if using mock provider)
# ---------------------------------------------------------------------------

# Google Gemini API key — obtain from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# OpenAI API key — obtain from https://platform.openai.com/
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Anthropic API key — obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ---------------------------------------------------------------------------
# Policy and Configuration Files
# ---------------------------------------------------------------------------

# Path to the policy rules YAML file (relative to backend/)
POLICY_FILE=app/core/policy/policy.yaml

# Path to the world configuration YAML file (held-out environment parameters)
WORLD_CONFIG_FILE=app/core/environment/world_config.yaml

# Path to the economic cost parameters YAML file
ECON_CONFIG_FILE=app/core/policy/econ_config.yaml

# ---------------------------------------------------------------------------
# Simulation and Evaluation
# ---------------------------------------------------------------------------

# Default random seed for synthetic data generation and evaluation runs
# Change this to produce a different (but still reproducible) run
SIM_DEFAULT_SEED=42

# ---------------------------------------------------------------------------
# Safety Controls
# ---------------------------------------------------------------------------

# Set to true to halt all action execution system-wide (emergency stop)
KILL_SWITCH_ENABLED=false

# Maximum number of simulation ticks per minute (rate-limiting)
RATE_LIMIT_SIMULATION_PER_MIN=60

# ---------------------------------------------------------------------------
# Payment Adapter
# ---------------------------------------------------------------------------

# NEVER set to true unless you are explicitly connecting to Razorpay test mode.
# When false (default), all payment effects are simulated and labelled in the UI.
RAZORPAY_ADAPTER_ENABLED=false

# Razorpay key ID — only used when RAZORPAY_ADAPTER_ENABLED=true
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE

# Razorpay key secret — only used when RAZORPAY_ADAPTER_ENABLED=true
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# ---------------------------------------------------------------------------
# Frontend (Next.js — variables prefixed NEXT_PUBLIC_ are exposed to the browser)
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend, as seen from the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" to show the "DEMO MODE" banner in the UI
NEXT_PUBLIC_DEMO_MODE=true
